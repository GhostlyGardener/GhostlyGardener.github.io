{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo" aria-label="Footer">
    <div class="container mt-0" aria-hidden="true">&nbsp;</div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo" aria-label="Footer">
    <div class="container" aria-hidden="true">&nbsp;</div>
  </footer>
{% endif %}
